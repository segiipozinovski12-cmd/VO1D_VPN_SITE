<Window x:Class="VO1D.Vpn.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:visual="clr-namespace:VO1D.Vpn.Views" Title="VO1D VPN" Width="1200" Height="840" MinWidth="1020" MinHeight="780" Background="Black" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Foreground="White" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#252525" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="Black"><TextBlock Text="VO1D  /  PRIVATE NETWORK" FontFamily="Consolas" FontSize="9" Foreground="#5B5B5B" VerticalAlignment="Center" Margin="25,0,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource WindowButton}" Click="MinimizeWindow" ToolTip="Свернуть в трей"><Path Data="M0,0 L10,0" Stroke="#888888" StrokeThickness="1"/></Button>
    <Button Style="{StaticResource WindowButton}" Click="MaximizeWindow" ToolTip="Развернуть"><Rectangle Width="9" Height="9" Stroke="#888888" StrokeThickness="1"/></Button>
    <Button Style="{StaticResource WindowButton}" Click="CloseWindow" ToolTip="Закрыть"><Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#AAAAAA" StrokeThickness="1"/></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" ClipToBounds="True">
   <visual:AmbientField ReduceMotion="{Binding ReduceAnimations}"/>
   <Grid x:Name="AppSurface" Visibility="{Binding AppVisible}" Margin="34,12,34,20">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
    <Grid>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="VO1D" FontSize="32" FontWeight="Black" FontStyle="Italic"/><Border Background="#0B0B0B" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="9" Margin="14,8,0,8" Padding="10,5"><TextBlock Text="WINDOWS" FontFamily="Consolas" Foreground="#858585" FontSize="9" VerticalAlignment="Center"/></Border></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Fill="#787878" Width="4" Height="4" Margin="0,0,9,0"/><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Micro}" Foreground="#999999" VerticalAlignment="Center"/><Button Content="{Binding AvatarLetter}" Tag="profile" Click="Navigate" Width="40" Height="40" Padding="0" Margin="24,0,0,0" ToolTip="Профиль"/></StackPanel>
    </Grid>
    <Grid x:Name="PageSurface" Grid.Row="1">
     <Grid x:Name="HomePage" Visibility="{Binding HomeVisible}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="328"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
       <Button Tag="servers" Click="Navigate" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
        <Border Style="{StaticResource Card}" Padding="20,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
         <Border Width="42" Height="42" Background="#191919" CornerRadius="14" BorderBrush="#3A3A3A" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="{Binding LocationCode}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Location}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Protocol}" Style="{StaticResource Micro}" Margin="0,4,0,0"/></StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Ping}" FontFamily="Consolas" FontSize="11" Foreground="#B7B7B7"/><Path Data="M0,0 L4,4 L0,8" Stroke="#999999" StrokeThickness="1.3" Margin="16,2,0,0"/></StackPanel>
        </Grid></Border>
       </Button>
       <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Button x:Name="PowerButton" Click="ToggleVpn" AutomationProperties.Name="Подключить или отключить VPN" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Width="386" MaxHeight="386" HorizontalAlignment="Center" VerticalAlignment="Stretch">
         <Viewbox Stretch="Uniform"><visual:ConnectionVortex x:Name="Vortex" Width="386" Height="386" State="{Binding State}" ReduceMotion="{Binding ReduceAnimations}"/></Viewbox>
        </Button>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"><TextBlock x:Name="ConnectionTitle" Text="{Binding StatusTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding StatusDetail}" FontSize="11" Foreground="#858585" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540" Margin="0,8,0,0"/><TextBlock Text="{Binding Duration}" FontFamily="Consolas" FontSize="10" Foreground="#575757" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
       </Grid>
       <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,6">
        <Border Style="{StaticResource Card}" Padding="19,14" CornerRadius="20" Margin="0,0,8,0"><StackPanel><TextBlock Text="↓  DOWNLOAD" Style="{StaticResource Micro}" FontSize="9"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="{Binding Download}" FontSize="25" FontWeight="Light"/><TextBlock Text="Mbps" FontSize="9" Foreground="#727272" VerticalAlignment="Bottom" Margin="5,0,0,5"/></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="19,14" CornerRadius="20" Margin="0,0,8,0"><StackPanel><TextBlock Text="↑  UPLOAD" Style="{StaticResource Micro}" FontSize="9"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="{Binding Upload}" FontSize="25" FontWeight="Light"/><TextBlock Text="Mbps" FontSize="9" Foreground="#727272" VerticalAlignment="Bottom" Margin="5,0,0,5"/></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="19,14" CornerRadius="20"><StackPanel><TextBlock Text="◌  LATENCY" Style="{StaticResource Micro}" FontSize="9"/><TextBlock Text="{Binding Ping}" FontSize="25" FontWeight="Light" Margin="0,9,0,0"/></StackPanel></Border>
       </UniformGrid>
      </Grid>
      <StackPanel Grid.Column="2" Margin="0,0,0,4">
       <Border Style="{StaticResource Card}" Padding="23"><StackPanel><TextBlock Text="ВАШЕ ПРОСТРАНСТВО" Style="{StaticResource Micro}" FontSize="9"/><TextBlock Text="Без границ." FontSize="25" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="{Binding Protection}" FontSize="11" Foreground="#808080" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <Border BorderBrush="#242424" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0"><StackPanel>
         <Grid><TextBlock Text="Внешний IP" Foreground="#777777" FontSize="11"/><TextBlock Text="{Binding PublicIp}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/></Grid>
         <Grid Margin="0,17,0,0"><TextBlock Text="Kill Switch" Foreground="#777777" FontSize="11"/><TextBlock Text="{Binding GuardLabel}" FontSize="11" HorizontalAlignment="Right"/></Grid>
         <Grid Margin="0,17,0,0"><TextBlock Text="Трафик" Foreground="#777777" FontSize="11"/><TextBlock Text="{Binding Traffic}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/></Grid>
        </StackPanel></Border>
       </StackPanel></Border>
       <UniformGrid Columns="3" Margin="0,14,0,0">
        <Button Click="Fastest" Padding="5,15" Margin="0,0,6,0"><StackPanel><Path Data="M8,0 L1,10 L6,10 L4,19 L13,7 L8,7 Z" Fill="#EEEEEE" Height="18" Stretch="Uniform"/><TextBlock Text="FASTEST" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></Button>
        <Button Click="RefreshPings" Padding="5,15" Margin="0,0,6,0"><StackPanel><Path Data="M2,5 A7,7 0 1 1 1,12 M2,1 L2,6 L7,6" Stroke="#EEEEEE" StrokeThickness="1.5" Height="18" Stretch="Uniform"/><TextBlock Text="{Binding PingAction}" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></Button>
        <Button Click="ToggleAuto" Padding="5,15"><StackPanel><TextBlock Text="A" FontSize="18" FontFamily="Consolas" HorizontalAlignment="Center"/><TextBlock Text="{Binding AutoLabel}" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
       </UniformGrid>
       <Grid Margin="1,27,0,12"><TextBlock Text="ЛОКАЦИИ" Style="{StaticResource Micro}" FontSize="9"/><Button Content="ВСЕ  ↗" Tag="servers" Click="Navigate" Background="Transparent" BorderThickness="0" Padding="2,0" FontSize="9" HorizontalAlignment="Right"/></Grid>
       <ItemsControl ItemsSource="{Binding PreviewServers}" ItemTemplate="{StaticResource ServerRow}"/>
      </StackPanel>
     </Grid>
     <ScrollViewer x:Name="ServersPage" Visibility="{Binding ServersVisible}"><StackPanel Margin="0,12,0,12"><Grid><StackPanel><TextBlock Text="Локации" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding CountryCount}" Foreground="#777777" Margin="0,8,0,0"/></StackPanel><Button Content="Обновить маршруты ↻" Click="RefreshServers" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,25,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск страны или кода"/><CheckBox Grid.Column="2" Content="Избранные" IsChecked="{Binding FavoritesOnly}"/></Grid><ItemsControl ItemsSource="{Binding FilteredServers}" ItemTemplate="{StaticResource ServerRow}"/><TextBlock Text="Задержка измеряется по настоящему соединению с сервером." Foreground="#606060" FontSize="11" Margin="0,14,0,0"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="ProfilePage" Visibility="{Binding ProfileVisible}"><StackPanel Margin="0,12,0,18"><TextBlock Text="Ваш профиль" Style="{StaticResource PageTitle}"/><Grid Margin="0,25,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><Border Width="66" Height="66" CornerRadius="23" Background="#161616" BorderBrush="#555555" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="{Binding AvatarLetter}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBox Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}" Margin="0,22,0,0"/><TextBlock Text="{Binding Subscription}" FontSize="15" Margin="0,21,0,0"/><TextBlock Text="{Binding AccountId}" Style="{StaticResource Micro}" Margin="0,7,0,0"/><Button Content="Продлить подписку ↗" Click="OpenPlans" Style="{StaticResource Primary}" Margin="0,25,0,0"/><Button Content="Выйти из аккаунта" Click="Logout" Background="Transparent" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Добавить доступ" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Ключ из Telegram или личная VPN-ссылка." Foreground="#858585" FontSize="12" Margin="0,9,0,18" TextWrapping="Wrap"/><TextBox Text="{Binding ActivationInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="ActivationKeyDown" MinHeight="92" TextWrapping="Wrap"/><Button Content="Добавить" Click="Activate" IsEnabled="{Binding CanActivate}" Style="{StaticResource Primary}" Margin="0,14,0,0"/><Border BorderBrush="#242424" BorderThickness="0,1,0,0" Padding="0,23,0,0" Margin="0,25,0,0"><StackPanel><TextBlock Text="Нужна помощь?" FontSize="16"/><TextBlock Text="Поддержка VO1D поможет с ключом и подключением." Foreground="#777777" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,14"/><Button Content="Открыть поддержку ↗" Click="OpenSupport"/></StackPanel></Border></StackPanel></Border>
     </Grid></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="{Binding SettingsVisible}"><StackPanel Margin="0,12,0,18"><TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/><TextBlock Text="Ваше соединение. Ваши правила." Foreground="#777777" Margin="0,8,0,25"/>
      <Border Style="{StaticResource Card}"><StackPanel><CheckBox Content="Подключаться при запуске" IsChecked="{Binding AutoConnect}"/><TextBlock Text="Использовать последнюю выбранную локацию." Foreground="#777777" FontSize="11" Margin="0,7,60,25"/><CheckBox Content="Kill Switch" IsChecked="{Binding KillSwitch}"/><TextBlock Text="Блокировать обход VPN при обрыве, пока приложение открыто." Foreground="#777777" FontSize="11" Margin="0,7,60,25"/><CheckBox Content="Stealth Mode" IsChecked="{Binding Stealth}"/><TextBlock Text="Предпочитать REALITY и пробовать запасные маршруты." Foreground="#777777" FontSize="11" Margin="0,7,60,25"/><CheckBox Content="Уменьшить анимации" IsChecked="{Binding ReduceAnimations}"/><TextBlock Text="Статичный фон и мгновенные переходы." Foreground="#777777" FontSize="11" Margin="0,7,60,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Сервер приложения" FontSize="15" FontWeight="SemiBold"/><TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=LostFocus}" Margin="0,14,0,0"/><TextBlock Text="Адрес уже настроен как в iOS. Полный код VO1D1 может заменить его." Foreground="#777777" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="VO1D / WINDOWS  •  XRAY + SYSTEM TUN" Style="{StaticResource Micro}" Margin="0,22,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="7" CornerRadius="25" HorizontalAlignment="Center" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal">
     <Button x:Name="HomeNav" Tag="home" Click="Navigate" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><Path Data="M1,8 L9,1 L17,8 M3,7 L3,17 L7,17 L7,11 L11,11 L11,17 L15,17 L15,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="18"/><TextBlock Text="Главная" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ServersNav" Tag="servers" Click="Navigate" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><Path Data="M9,1 A6,6 0 1 1 8.99,13 L9,18 L4,11 M9,5 A2,2 0 1 1 8.99,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="18"/><TextBlock Text="Локации" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ProfileNav" Tag="profile" Click="Navigate" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><Path Data="M9,1 A3,3 0 1 1 8.99,7 M2,18 L2,15 Q2,10 9,10 Q16,10 16,15 L16,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="18"/><TextBlock Text="Профиль" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="SettingsNav" Tag="settings" Click="Navigate" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><Path Data="M0,5 L18,5 M0,13 L18,13 M5,2 L5,8 M12,10 L12,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="18"/><TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel></Border>
   </Grid>
   <Grid x:Name="LoginSurface" Visibility="{Binding LoginVisible}" Margin="64,42,64,36"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions><TextBlock Text="VO1D" FontSize="39" FontWeight="Black" FontStyle="Italic"/>
     <StackPanel Grid.Row="1" VerticalAlignment="Center"><visual:ConnectionVortex Width="380" Height="380" Decorative="True" ReduceMotion="{Binding ReduceAnimations}"/><TextBlock Text="СВОБОДА БЕЗ ГРАНИЦ" FontFamily="Consolas" FontSize="10" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
     <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="Ваше личное пространство." FontSize="21" FontWeight="Light"/><TextBlock Text="PRIVATE. SECURE. YOURS." Style="{StaticResource Micro}" Margin="0,11,0,0"/></StackPanel>
    </Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border Width="56" Height="56" CornerRadius="18" Background="#131313" BorderBrush="#464646" BorderThickness="1" HorizontalAlignment="Left"><Path Data="M4,8 A5,5 0 1 1 9,13 L3,19 L0,16 L6,10 M13,4 L14,5" Stroke="White" StrokeThickness="1.6" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Войти в VO1D" FontSize="31" FontWeight="SemiBold" Margin="0,23,0,0"/><TextBlock Text="Введите ключ, полученный в Telegram." Foreground="#888888" FontSize="12" Margin="0,11,0,30"/>
     <TextBlock Text="КЛЮЧ ДОСТУПА" Style="{StaticResource Micro}" FontSize="9" Margin="0,0,0,10"/><TextBox Text="{Binding ActivationInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" KeyDown="ActivationKeyDown" MinHeight="62" TextWrapping="Wrap" ToolTip="VOID-XXXX-XXXX-XXXX или полный VO1D1-код"/>
     <Button Click="Activate" IsEnabled="{Binding CanActivate}" Style="{StaticResource Primary}" Margin="0,15,0,0"><Grid Width="335"><TextBlock Text="{Binding ActivationLabel}" Foreground="Black" FontSize="13" FontWeight="SemiBold"/><Path x:Name="LoginSpinner" Data="M0,7 A7,7 0 1 1 7,14" Stroke="Black" StrokeThickness="1.5" Width="16" Height="16" HorizontalAlignment="Right" RenderTransformOrigin=".5,.5" Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path><TextBlock Text="↗" Foreground="Black" HorizontalAlignment="Right" FontSize="15" x:Name="LoginArrow"/></Grid></Button>
     <TextBlock Text="Проверка ключа на сервере VO1D" Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}" FontSize="10" Foreground="#8F8F8F" Margin="0,13,0,0"/>
     <TextBlock Text="Или вставьте личную VPN-ссылку." FontSize="10" Foreground="#5F5F5F" Margin="0,13,0,0"/>
     <Border BorderBrush="#242424" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,22,0,0"><Grid><TextBlock Text="Нет ключа?" Foreground="#777777" VerticalAlignment="Center" FontSize="12"/><Button Click="OpenPlans" Content="Получить доступ ↗" HorizontalAlignment="Right" FontSize="11" Background="Transparent"/></Grid></Border>
    </StackPanel>
   </Grid>
   <Border x:Name="ErrorToast" Visibility="{Binding ErrorVisible}" Style="{StaticResource Card}" BorderBrush="#646464" CornerRadius="16" Padding="17,13" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="720" Margin="20,82,20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Click="DismissError" Background="Transparent" BorderThickness="0" Padding="7" Margin="12,0,0,0"/></Grid></Border>
   <Grid x:Name="StartupOverlay" Background="Black">
    <visual:AmbientField ReduceMotion="{Binding ReduceAnimations}"/>
    <Grid Margin="48,30,48,32"><Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions><TextBlock Text="VO1D / BOOT" Style="{StaticResource Micro}" FontSize="9"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="PRIVACY   /   SECURE" FontFamily="Consolas" FontSize="9" Foreground="#969696"/><TextBlock Text="ANONYMITY /   FREEDOM" FontFamily="Consolas" FontSize="9" Foreground="#666666" Margin="0,9,0,0"/></StackPanel>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="VO1D" FontSize="88" FontWeight="Black" FontStyle="Italic" HorizontalAlignment="Center"><TextBlock.Effect><DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="32" Opacity=".20"/></TextBlock.Effect></TextBlock><TextBlock Text="P R I V A T E   N E T W O R K" FontFamily="Consolas" FontSize="10" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,17,0,42"/><Border Style="{StaticResource Card}" Width="430" Padding="22,20"><StackPanel><TextBlock Text="VO1D CORE" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="BootStatus" Text="Открываем ваше пространство…" Foreground="#8A8A8A" FontFamily="Consolas" FontSize="11" Margin="0,11,0,15"/><ProgressBar x:Name="BootProgress" Height="3" Minimum="0" Maximum="100" Value="4" BorderThickness="0" Foreground="White" Background="#222222"/></StackPanel></Border></StackPanel>
     <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="NATIVE WINDOWS CLIENT" Style="{StaticResource Micro}" FontSize="9"/><TextBlock Text="Ваше соединение начинается здесь." FontFamily="Consolas" Foreground="#888888" FontSize="11" Margin="0,14,0,0"/><Border Height="1" Background="#292929" Margin="0,20,0,0"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>
