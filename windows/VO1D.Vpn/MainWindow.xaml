<Window x:Class="VO1D.Vpn.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="VO1D VPN" Width="1160" Height="820" MinWidth="990" MinHeight="720" Background="#070709" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Foreground="White" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#303035" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Background="#0B0B0E"><TextBlock Text="VO1D / WINDOWS" FontFamily="Consolas" FontSize="10" Foreground="#7C7C86" VerticalAlignment="Center" Margin="23,0,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="—" Click="MinimizeWindow" Width="46" Background="Transparent" BorderThickness="0" Padding="0"/>
        <Button Content="□" Click="MaximizeWindow" Width="46" Background="Transparent" BorderThickness="0" Padding="0"/>
        <Button Content="×" Click="CloseWindow" Width="46" FontSize="21" Background="Transparent" BorderThickness="0" Padding="0"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Visibility="{Binding AppVisible}"><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#0B0B0E" BorderBrush="#202025" BorderThickness="0,0,1,0" Padding="18,25,18,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="7,0,0,36"><TextBlock Text="VO1D" FontFamily="Consolas" FontSize="31" FontWeight="Bold"/><TextBlock Text="PRIVATE NETWORK" Style="{StaticResource Micro}" Margin="1,7,0,0" FontSize="9"/></StackPanel>
        <StackPanel Grid.Row="1"><Button x:Name="HomeNav" Style="{StaticResource Nav}" Click="Navigate" Tag="home" Content="◉    Подключение"/><Button x:Name="ServersNav" Style="{StaticResource Nav}" Click="Navigate" Tag="servers" Content="◎    Локации"/><Button x:Name="ProfileNav" Style="{StaticResource Nav}" Click="Navigate" Tag="profile" Content="◌    Профиль"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Navigate" Tag="settings" Content="⚙    Настройки"/></StackPanel>
        <StackPanel Grid.Row="3"><Border BorderBrush="#27272C" BorderThickness="0,1,0,0" Padding="3,18,0,16"><StackPanel><TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subscription}" Style="{StaticResource Micro}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border><Button Click="OpenSupport" Content="Поддержка ↗" Background="Transparent" Foreground="#8E8E98" BorderBrush="#242429" FontSize="11"/></StackPanel>
      </Grid></Border>
      <Grid Grid.Column="1" Margin="30,23,30,23"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="2" Visibility="{Binding ErrorVisible}" BorderBrush="#565057" BorderThickness="1" Background="#1B171B" CornerRadius="11" Padding="14" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap" Foreground="#D9CDD5"/><Button Grid.Column="1" Content="×" Click="DismissError" Background="Transparent" BorderThickness="0" Padding="0"/></Grid></Border>
        <Grid Grid.RowSpan="2" Visibility="{Binding HomeVisible}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Ваше пространство" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Micro}" Margin="0,7,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Navigate" Tag="profile" Width="42" Height="42" Padding="0" Content="{Binding AvatarLetter}" FontFamily="Consolas" FontSize="17"/></Grid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="24,20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel VerticalAlignment="Center">
                <Grid Width="284" Height="284" HorizontalAlignment="Center">
                  <Ellipse Stroke="#1C1C22" StrokeThickness="1" Margin="1"/><Ellipse Stroke="#15151B" StrokeThickness="1" Margin="19"/>
                  <Ellipse x:Name="Halo" Stroke="#F5F5F5" StrokeThickness="1.2" Margin="12" Opacity="0.05"><Ellipse.Effect><BlurEffect Radius="11"/></Ellipse.Effect></Ellipse>
                  <Ellipse x:Name="ConnectionRing" Stroke="#3F3F49" StrokeThickness="1.5" Margin="41"/>
                  <Ellipse x:Name="PulseRing" Stroke="#BDBDC9" StrokeThickness="1" Margin="30" Opacity="0.0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                  <Path x:Name="Spinner" Data="M 142,27 A 115,115 0 0 1 257,142" Stroke="#F0F0F6" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform CenterX="0" CenterY="0"/></Path.RenderTransform></Path>
                  <Button x:Name="PowerButton" Click="ToggleVpn" Width="150" Height="150" Padding="0" Background="#131318" BorderThickness="0" ToolTip="Подключить / отключить VPN">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="75" BorderThickness="1" BorderBrush="#292930"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#202026"/><Setter TargetName="Circle" Property="BorderBrush" Value="#777780"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Background" Value="#2A2A31"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                    <Grid Width="49" Height="49"><Viewbox><Path x:Name="PowerSymbol" Data="M 12,2 L 12,11 M 6,5 A 9,9 0 1 0 18,5" Stroke="#F4F4F8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox><Viewbox><Path x:Name="CheckSymbol" Visibility="Collapsed" Data="M 4,12 L 10,18 L 21,6" Stroke="#F4F4F8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox></Grid>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding StatusTitle}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding StatusDetail}" FontSize="11" Foreground="#777781" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="310"/>
                <TextBlock Text="{Binding Duration}" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center" Foreground="#A3A3AD" Margin="0,15,0,15"/>
              </StackPanel>
              <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,19"><Button Click="Fastest" Padding="4,14" Margin="0,0,5,0"><StackPanel><TextBlock Text="ϟ" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="FASTEST" Style="{StaticResource Micro}" Foreground="#D1D1D8" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="ЛУЧШИЙ ПИНГ" Style="{StaticResource Micro}" FontSize="8" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button><Button Click="RefreshPings" Padding="4,14" Margin="3,0,3,0"><StackPanel><TextBlock Text="↻" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="PING" Style="{StaticResource Micro}" Foreground="#D1D1D8" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="{Binding PingAction}" Style="{StaticResource Micro}" FontSize="8" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button><Button Click="ToggleAuto" Padding="4,14" Margin="5,0,0,0"><StackPanel><TextBlock Text="Ⓐ" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="AUTO" Style="{StaticResource Micro}" Foreground="#D1D1D8" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="{Binding AutoLabel}" Style="{StaticResource Micro}" FontSize="8" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button></UniformGrid>
              <Border Grid.Row="2" BorderBrush="#24242A" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel><TextBlock Text="{Binding Protection}" FontSize="10" Foreground="#A7A7B0" HorizontalAlignment="Center"/><TextBlock Text="VO1D / ENCRYPTED CONNECTION" Style="{StaticResource Micro}" FontSize="8" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
            </Grid></Border>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="АКТИВНЫЙ МАРШРУТ" Style="{StaticResource Micro}"/><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="#25252B"><TextBlock Text="{Binding LocationCode}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Location}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Ping}" Style="{StaticResource Micro}" Margin="0,5,0,0"/></StackPanel></Grid><Button Click="Navigate" Tag="servers" Content="Сменить локацию  →" Margin="0,16,0,0" Padding="10,9" FontSize="11"/></StackPanel></Border>
              <UniformGrid Grid.Row="1" Columns="2" Margin="0,14,0,14"><Border Style="{StaticResource Card}" Padding="17" Margin="0,0,6,0"><StackPanel><TextBlock Text="↓  DOWNLOAD" Style="{StaticResource Micro}" FontSize="9"/><TextBlock Text="{Binding Download}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock Text="Mbps" Style="{StaticResource Micro}" FontSize="9"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="17" Margin="6,0,0,0"><StackPanel><TextBlock Text="↑  UPLOAD" Style="{StaticResource Micro}" FontSize="9"/><TextBlock Text="{Binding Upload}" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock Text="Mbps" Style="{StaticResource Micro}" FontSize="9"/></StackPanel></Border></UniformGrid>
              <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="СЕТЬ И ЗАЩИТА" Style="{StaticResource Micro}" Margin="0,0,0,18"/><Grid Margin="0,0,0,15"><TextBlock Text="Внешний IP" FontSize="11" Foreground="#8C8C97"/><TextBlock Text="{Binding PublicIp}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/></Grid><Border BorderBrush="#25252B" BorderThickness="0,1,0,0"/><Grid Margin="0,15"><TextBlock Text="Протокол" FontSize="11" Foreground="#8C8C97"/><TextBlock Text="{Binding Protocol}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/></Grid><Border BorderBrush="#25252B" BorderThickness="0,1,0,0"/><Grid Margin="0,15"><TextBlock Text="Kill Switch" FontSize="11" Foreground="#8C8C97"/><TextBlock Text="{Binding GuardLabel}" FontSize="11" HorizontalAlignment="Right"/></Grid><Border BorderBrush="#25252B" BorderThickness="0,1,0,0"/><Grid Margin="0,15,0,0"><TextBlock Text="Трафик сессии" FontSize="11" Foreground="#8C8C97"/><TextBlock Text="{Binding Traffic}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/></Grid></StackPanel></Border>
            </Grid>
          </Grid>
        </Grid>
        <Grid Grid.RowSpan="2" Visibility="{Binding ServersVisible}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Локации" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding CountryCount}" Style="{StaticResource Micro}" Margin="0,7,0,0"/></StackPanel><Button Click="RefreshServers" Content="Обновить ↻" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid><Grid Grid.Row="1" Margin="0,24,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск страны"/><CheckBox Grid.Column="2" Content="Избранное" IsChecked="{Binding FavoritesOnly}"/></Grid><ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding FilteredServers}" ItemTemplate="{StaticResource ServerRow}"/></ScrollViewer></Grid>
        <ScrollViewer Grid.RowSpan="2" Visibility="{Binding ProfileVisible}"><StackPanel><TextBlock Text="Профиль" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Ваш доступ к VO1D" Style="{StaticResource Micro}" Margin="0,7,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ИМЯ" Style="{StaticResource Micro}"/><TextBox Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}" Margin="0,10,0,18" MaxLength="32"/><Grid><TextBlock Text="{Binding AccountId}" Style="{StaticResource Micro}"/><TextBlock Text="{Binding Subscription}" HorizontalAlignment="Right" Foreground="#B7B7C0" FontSize="11"/></Grid></StackPanel></Border>
          <TextBlock Text="Подписка" FontSize="19" FontWeight="SemiBold" Margin="0,25,0,14"/><UniformGrid Columns="4"><Button Click="OpenPlans" Tag="1" Margin="0,0,8,0" Padding="8,20"><StackPanel><TextBlock Text="1 месяц" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="$1.99" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button><Button Click="OpenPlans" Tag="3" Margin="3,0,5,0" Padding="8,20"><StackPanel><TextBlock Text="3 месяца" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="$4.99" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button><Button Click="OpenPlans" Tag="6" Margin="5,0,3,0" Padding="8,20"><StackPanel><TextBlock Text="6 месяцев" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="$8.99" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button><Button Click="OpenPlans" Tag="12" Margin="8,0,0,0" Padding="8,20"><StackPanel><TextBlock Text="12 месяцев" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="$14.99" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button></UniformGrid>
          <Border Style="{StaticResource Card}" Margin="0,24,0,0"><StackPanel><TextBlock Text="Добавить ключ или VPN-ссылку" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="VO1D1… / VOID-… / VLESS / VMess / Trojan / SS / Hysteria2" Style="{StaticResource Micro}" Margin="0,9,0,16" TextWrapping="Wrap"/><TextBox Text="{Binding ActivationInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="32768"/><Button Click="Activate" Content="Активировать" Style="{StaticResource Primary}" Margin="0,14,0,0" IsEnabled="{Binding CanActivate}"/></StackPanel></Border><Button Click="Logout" Content="Выйти из аккаунта" HorizontalAlignment="Left" Foreground="#A5A5B0" Background="Transparent" Margin="0,22,0,12"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer Grid.RowSpan="2" Visibility="{Binding SettingsVisible}"><StackPanel><TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Параметры применяются при следующем подключении" Style="{StaticResource Micro}" Margin="0,7,0,24"/>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource Micro}" Margin="0,0,0,20"/><CheckBox Content="Автоподключение при открытии VO1D" IsChecked="{Binding AutoConnect}" Margin="0,0,0,23"/><CheckBox Content="Kill Switch" IsChecked="{Binding KillSwitch}"/><TextBlock Text="Блокирует обход VPN при обрыве, пока VO1D открыт." FontSize="10" Foreground="#70707C" Margin="0,9,60,22" TextWrapping="Wrap"/><CheckBox Content="Предпочитать REALITY-маршруты" IsChecked="{Binding Stealth}" Margin="0,0,0,23"/><CheckBox Content="Уменьшить анимации" IsChecked="{Binding ReduceAnimations}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="ЗАЩИТА ТРАФИКА" Style="{StaticResource Micro}" Margin="0,0,0,15"/><TextBlock Text="IPv4 и IPv6 направляются через виртуальный адаптер VO1D. DNS-запросы проходят через VPN. Приложение проверяет передачу данных перед показом статуса «Подключено»." Foreground="#A1A1AC" FontSize="12" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="АДРЕС VO1D API" Style="{StaticResource Micro}"/><TextBlock Text="Полная строка VO1D1… устанавливает адрес автоматически." Foreground="#777784" FontSize="11" Margin="0,9,0,14"/><TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=LostFocus}" ToolTip="https://ваш-сервер"/></StackPanel></Border><TextBlock Text="VO1D VPN / WINDOWS 1.0.0" Style="{StaticResource Micro}" Margin="0,23,0,12"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" Visibility="{Binding LoginVisible}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Grid ClipToBounds="True"><Grid.Background><RadialGradientBrush Center="0.48,0.46" GradientOrigin="0.48,0.46" RadiusX="0.7" RadiusY="0.7"><GradientStop Color="#1B1B23" Offset="0"/><GradientStop Color="#09090C" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Ellipse Width="480" Height="480" Stroke="#252530" StrokeThickness="1"/><Ellipse Width="370" Height="370" Stroke="#2C2C38" StrokeThickness="1"/><Ellipse Width="258" Height="258" Stroke="#4A4A58" StrokeThickness="1"/><Ellipse Width="150" Height="150" Stroke="#6E6E7D" StrokeThickness="1"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="VO1D" FontSize="69" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/><TextBlock Text="YOUR PRIVATE SPACE" FontFamily="Consolas" FontSize="11" Foreground="#8A8A99" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
        <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,44"><TextBlock Text="Свобода подключения." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Один интерфейс. Ваш защищённый маршрут." FontSize="12" Foreground="#747480" Margin="0,11,0,0"/><TextBlock Text="NATIVE WINDOWS / IPv4 + IPv6" Style="{StaticResource Micro}" Margin="0,22,0,0" FontSize="9"/></StackPanel>
      </Grid>
      <ScrollViewer Grid.Column="1" VerticalAlignment="Center"><StackPanel Margin="48,25,48,25" MaxWidth="410"><TextBlock Text="Войти в VO1D" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Добавьте ключ доступа или готовую VPN-ссылку." FontSize="12" Foreground="#878793" Margin="0,12,0,26" TextWrapping="Wrap" LineHeight="21"/><TextBlock Text="ВАШ КЛЮЧ ИЛИ VPN-ССЫЛКА" Style="{StaticResource Micro}" Margin="0,0,0,10"/><TextBox Text="{Binding ActivationInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" MaxLength="32768" KeyDown="ActivationKeyDown"/><Button Content="Войти в анонимность  →" Click="Activate" Style="{StaticResource Primary}" Padding="15,16" Margin="0,15,0,0" IsEnabled="{Binding CanActivate}"/>
        <TextBlock Text="Ключ с iPhone привязан к устройству. Для Windows можно использовать отдельный ключ или VPN-ссылку." FontSize="10" Foreground="#6C6C79" TextWrapping="Wrap" LineHeight="18" Margin="0,15,0,21"/>
        <Expander Header="Указать адрес API вручную" Foreground="#9B9BA7" FontSize="11"><TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=LostFocus}" Margin="0,12,0,0" ToolTip="HTTPS-адрес вашего API"/></Expander>
        <Border Visibility="{Binding ErrorVisible}" Background="#20191F" BorderBrush="#51434E" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,16,0,0"><TextBlock Text="{Binding Error}" FontSize="11" Foreground="#DECFD8" TextWrapping="Wrap"/></Border>
        <Border BorderBrush="#292930" BorderThickness="0,1,0,0" Margin="0,27,0,0" Padding="0,23,0,0"><Grid><TextBlock Text="Ещё нет доступа?" Foreground="#858591" VerticalAlignment="Center" FontSize="12"/><Button Click="OpenPlans" Content="Получить подписку ↗" HorizontalAlignment="Right" FontSize="11"/></Grid></Border><TextBlock Text="VLESS · REALITY · VMess · Trojan · SS · Hysteria2" Style="{StaticResource Micro}" FontSize="8" Margin="0,23,0,0" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="StartupOverlay" Grid.Row="1" Background="#070709"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="VO1D" FontFamily="Consolas" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="ОТКРЫВАЕМ ВАШЕ ПРОСТРАНСТВО" Style="{StaticResource Micro}" Margin="0,18,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
  </Grid></Border>
</Window>
